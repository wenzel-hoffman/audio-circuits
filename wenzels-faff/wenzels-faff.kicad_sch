	(text "Gain for the CLEAN blend-in signal (U1C).\nAround 15 dB boost."
		(exclude_from_sim no)
		(at 166.878 68.326 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "380498c0-004d-467c-a756-92215235bc65")
	)
	(text "TAME ≈ 21.95 kHz → 495 Hz\nTIGHT ≈ 49 Hz → 258 Hz"
		(exclude_from_sim no)
		(at 321.564 116.586 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4c2e1297-47d2-484c-b8ed-c8fc1adea5a6")
	)
	(text "Q1, Q2, Q3, Q4 candidates:\n\n- Silicon 2n2369a (selected for hFE matching 30-60 range)\n- Germanium UFO Soviet MP37B (“МП37Б”, note that non-“B”/“Б” model can only handle 15V max!)\n\nNote that germaniums will sound significantly different from silicon, more round, more overdrive-like."
		(exclude_from_sim no)
		(at 17.018 279.4 0)
		(effects
			(font
				(size 3.048 3.048)
				(thickness 0.6096)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4db56d34-ea17-462d-960d-efec316bf992")
	)
	(text "Input buffer (U1A).\nR5 and R7 are in parallel for AC.\nInput impedance is ≈1M."
		(exclude_from_sim no)
		(at 24.13 74.422 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5691e9ea-0206-4f25-a7cc-f3d48601cdab")
	)
	(text "VOLTS1 and VOLTS2 are ranging:\n- ≈1.15V-≈17.82V (for 18V supply)\n- ≈0.57V-≈8.91V (for 9V supply)\n\nWith STARVE switch engaged:\n- ≈1.15V-≈9.25V (for 18V supply)\n- ≈0.57V-≈4.63V (for 9V supply)\n\nIgnoring RC filtering network voltage drop.\nIn reality the voltages will be a bit lower."
		(exclude_from_sim no)
		(at 131.318 22.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8bc11166-4d8f-40c7-965d-a9018d437b69")
	)
	(text "Flipping phase here (U1B).\nOriginal phase polarity will be\nrestored at the final mixing stage (U1D)."
		(exclude_from_sim no)
		(at 87.63 71.628 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f388ea0-1e14-45ae-91b8-567eda72b574")
	)
	(text "Final mixing stage (U1D, inverting).\nMixing the fuzz output\nand CLEAN blend-in.\nPhase polarity is restored\nwhich was previously flipped (at U1B)."
		(exclude_from_sim no)
		(at 250.698 66.294 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a2995063-5cc8-4f6a-b4ad-6791688dff75")
	)
	(text "Will work at 9V, but headroom will be reduced.\nClean blend may clip on strong transients\n(more likely on a bass guitar).\n18V recommended."
		(exclude_from_sim no)
		(at 66.802 26.416 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a78e3cd8-ef6d-4070-a730-0dbc2233c85b")
	)
