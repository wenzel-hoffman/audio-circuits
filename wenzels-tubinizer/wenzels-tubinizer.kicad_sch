	(text "Technically you can feed the HV booster\nfrom the +15V of U5 and U4 would be\nnot necessary then, but in my case U5\nwas going into overload protection,\nit doesn’t have enough current capability\nto handle it. So I had to add U4."
		(exclude_from_sim no)
		(at 151.638 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bb42aaa2-b903-4f57-9cc4-2698a19a959f")
	)
