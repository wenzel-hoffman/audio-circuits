	)
	(text "You don’t need\nto cut anything\nhere, just make\nsure VOLUME pot\npin 2 goes to\nextension mod\nPCB input, and\nextension mod\nPCB output goes\nto the output\njack."
		(exclude_from_sim no)
		(at 369.57 172.974 0)
		(effects
